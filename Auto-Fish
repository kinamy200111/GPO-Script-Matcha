local function clickSellAlls()
    local g = gui("FishSellerGui")
    if not g then return 0 end
    local done, stall = 0, 0
    while alive() do
        local btn, rowName, before = nil, nil, 0
        pcall(function()
            local list = g.Main.Items.List
            for _, row in ipairs(list:GetChildren()) do
                local amt = 0
                for _, o in ipairs(row:GetDescendants()) do
                    if o.ClassName == "TextLabel" and o.Name == "Amount" then
                        local x = tostring(o.Text or ""):match("x(%d+)")
                        if x then amt = tonumber(x) end
                    end
                end
                if amt > 0 then
                    for _, o in ipairs(row:GetChildren()) do
                        if o.Name == "SellAll"
                            and (o.ClassName == "TextButton" or o.ClassName == "ImageButton")
                            and clickable(o) then
                            btn, rowName, before = o, row.Name, amt break
                        end
                    end
                    if btn then break end
                end
            end
        end)
        if not btn then break end
        local x, y = btnCenter(btn)
        if not x then break end
        print("[shop] sell " .. rowName .. " x" .. before .. " @" .. math.floor(x) .. "," .. math.floor(y))
        clickAt(x, y)
        task.wait(1.0)
        confirmAccept()
        task.wait(0.8)
        local after = fishAmounts()[rowName] or 0
        done = done + 1
        if after >= before then
            stall = stall + 1
            print("[shop] no sale progress (" .. rowName .. " still x" .. after .. ")")
        else
            stall = 0
        end
        if stall >= 3 or done > 40 then break end
    end
    return done
end


