local function buyBaitInner(amount)
    if not dialogueOpen() then pressKey(VK_E, 0.8) task.wait(0.8) end
    local q = nil
    for p = 1, 6 do
        q = shopQty()
        if q then print("[shop] qty page at step " .. p) break end
        if not dialogueOpen() then pressKey(VK_E, 0.8) task.wait(0.8) end
        npcGoExpect(nil)
        task.wait(1.0)
    end
    if not q then closeDialog() finishDots() return baitCount() or 0, "no qty page" end
    local txt, maxN = shopQtyText()
    print("[shop] qty: " .. tostring(txt and txt:sub(1, 80)) .. " MAX=" .. tostring(maxN))
    local money = peli()
    local afford = money and math.floor(money / BAIT_PRICE) or 9999
    local need = math.min(amount or 9999, maxN or 9999, afford)
    print("[shop] need=" .. need .. " want=" .. tostring(amount) .. " peli=" .. tostring(money))
    if need <= 0 then closeDialog() finishDots() return baitCount() or 0, "nothing to buy" end

    local fx, fy = fieldGuess(q)
    local filled = false
    if fx then
        print("[shop] field guess @" .. math.floor(fx) .. "," .. math.floor(fy))
        local cur0 = boxText(q.count)
        print("[shop] field before = " .. tostring(cur0))
        if cur0 and cur0:match(tostring(need)) then
            filled = true
            print("[shop] field already correct, skip typing")
        else
            for t = 1, 2 do
                clickAt(fx, fy) task.wait(0.6)
                for i = 1, 12 do backspace() end
                typeNumber(need) task.wait(0.3)
                pressEnter() task.wait(0.4)
                local back = boxText(q.count)
                print("[shop] field try " .. t .. " = " .. tostring(back))
                if back and back:match(tostring(need)) then filled = true break end
                if back == nil then filled = true print("[shop] field unreadable, single input done") break end
                fx = fx + (t == 1 and 35 or -70)
            end
        end
    else
        print("[shop] no buy pos, skip field")
    end

    local before = maxN
    local bought, still = 0, 0
    local clicks = math.min(math.max(need + 5, 8), 90)
    for t = 1, clicks do
        q = shopQty()
        if not q then print("[shop] qty page gone") break end
        local x, y = btnCenter(q.buy)
        if not x then print("[shop] buy not clickable") break end
        clickAt(x, y)
        task.wait(1.2)
        local _, now = shopQtyText()
        if now and before and now < before then
            bought = bought + (before - now)
            before = now
            still = 0
            print("[shop] bought total=" .. bought .. " MAX=" .. now)
        else
            still = still + 1
            print("[shop] buy click " .. t .. " no MAX change (still=" .. still .. ")")
        end
        if bought >= need then break end
        if filled and t >= 3 then break end
        if still >= 5 then break end
    end
    local _, finalMax = shopQtyText()
    local have = baitCount() or (finalMax and (BAIT_MAX - finalMax)) or 0
    print("[shop] bought=" .. bought .. "/" .. need .. " have~" .. have)
    local q2 = shopQty()
    if q2 and q2.cancel then
        local x, y = btnCenter(q2.cancel)
        if x then clickAt(x, y) task.wait(0.5) end
    end
    finishDots()
    task.wait(0.5)
    closeDialog()
    task.wait(0.5)
    return have, (bought >= need) and "ok-qty" or ("partial " .. bought .. "/" .. need)
end

local function buyBait(amount)
    if st.buyBusy then print("[shop] buy already running, skip") return baitCount() or 0, "busy" end
    st.buyBusy = true
    local ok, r1, r2 = pcall(buyBaitInner, amount)
    st.buyBusy = false
    if ok then return r1, r2 end
    print("[shop] buy error: " .. tostring(r1))
    return baitCount() or 0, "error"
end

