local function dialogueText()
    local g = gui("NPCCHAT")
    if not g then return nil end
    local parts = {}
    pcall(function()
        local d = g:FindFirstChild("Frame")
        d = d and d:FindFirstChild("ImageLabel")
        d = d and d:FindFirstChild("desc")
        if not d then return end
        for _, o in ipairs(d:GetDescendants()) do
            if o.ClassName == "TextLabel" and o.Name:find("Group") and not o.Name:find("Char") then
                local ok, t, x = pcall(function() return o.Text, o.AbsolutePosition.X end)
                if ok and t and t ~= "" then parts[#parts + 1] = { t = t, x = x or 0 } end
            end
        end
    end)
    table.sort(parts, function(a, b) return a.x < b.x end)
    local s = ""
    for _, p in ipairs(parts) do s = s .. p.t .. " " end
    return s
end

