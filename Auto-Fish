        aimBox.Position = Vector2.new(ax - 7, ay - 7)
        aimBox.Visible = true
    else
        aimBox.Visible = false
    end
    local camP = nil
    pcall(function() camP = Camera.Position end)
    for _, m in ipairs(spotMk) do
        local sp, vis = WorldToScreen(m.p)
        if vis then
            m.c.Position = sp
            m.c.Visible = true
            local dist = ""
            if camP then
                local ok, d = pcall(function() return (camP - m.p).Magnitude end)
                if ok and d then dist = " " .. math.floor(d) .. "m" end
            end
            m.t.Text = m.n .. dist
            m.t.Position = Vector2.new(sp.X, sp.Y - 30)
            m.t.Visible = true
        else
            m.c.Visible = false
            m.t.Visible = false
        end
    end
end)


task.spawn(function()
    while alive() do
        task.wait(0.2)
        if not st.on then hold(false) task.wait(0.3) continue end
        if st.shopping then hold(false) task.wait(0.5) continue end
        if st.autoShop then
            local b = baitCount() or st.baitHave
            local needBuy = (b ~= nil and b < st.buyBelow)
            local needSell = st.autoSell and (st.catches - st.soldAt >= st.sellEveryN)
            if needBuy or needSell then shopCycle(needBuy, needSell) continue end
        end
        local ok, err = pcall(function()
            local r = rod()
            if not r then st.phase = "wait" st.info = "equip the rod" return end
            local h = hook()
            if not h then

                st.phase = "cast"
                st.info = "charging"
                local ax, ay = aimPoint()
                if ax then
                    mousemoveabs(ax, ay) task.wait(0.15)
                    mousemoverel(2, 0) task.wait(0.03)
                    mousemoverel(-2, 0) task.wait(0.05)
                end
                hold(true)
                task.wait(st.charge)
                hold(false)
                st.casts = st.casts + 1
                if st.baitHave then st.baitHave = math.max(0, st.baitHave - 1) end
                local t0 = tick()
                while alive() and st.on and tick() - t0 < 6 do
                    if hook() then break end
                    task.wait(0.2)
                end
                if not hook() then st.info = "cast failed (move? air?)" end
                return
            end
            if hookCaught() then

                st.phase = "minigame" st.info = "reeling"
                local t0 = tick()
                local lastF, lastT, fishV = nil, nil, 0
                local lastB, lastT2, markV = nil, nil, 0
                local PREDICT = 0.12
                local mconn
                mconn = RunService.RenderStepped:Connect(function()
                    if not (alive() and st.on and hook()) then return end
                    local now = tick()
                    local bill = gui("FishingUIBill")
                    local fr = bill and bill.Frame
                    if not fr then return end
                    local ok, p, g, fpos, fsize = pcall(function()
                        return fr:FindFirstChild("Player"), fr:FindFirstChild("Goal"),
                               fr.AbsolutePosition, fr.AbsoluteSize
                    end)
                    if not (ok and p and g and fsize and fsize.Y > 0) then
                        local h = miniHold()
                        if h ~= nil then hold(h) end
                        return
                    end
                    local ok2, pp, ps, gp, gs = pcall(function()
                        return p.AbsolutePosition, p.AbsoluteSize, g.AbsolutePosition, g.AbsoluteSize
                    end)
                    if not ok2 then return end
                    local barY = (pp.Y + ps.Y / 2 - fpos.Y) / fsize.Y
                    local fishY = (gp.Y + gs.Y / 2 - fpos.Y) / fsize.Y
                    if lastF and lastT then
                        local dt = now - lastT
                        if dt > 0.001 and dt < 0.5 then
                            local v = (fishY - lastF) / dt
                            fishV = fishV * 0.7 + math.clamp(v, -3, 3) * 0.3
                        end
                    end
                    lastF, lastT = fishY, now
                    if lastB then
                        local dt2 = now - lastT2
                        if dt2 > 0.001 and dt2 < 0.5 then
                            local mv = (barY - lastB) / dt2
                            markV = markV * 0.7 + math.clamp(mv, -3, 3) * 0.3
                        end
                    end
                    lastB, lastT2 = barY, now

                    local target = fishY + fishV * PREDICT
                    local des = math.clamp(3.0 * (target - barY), -1.2, 1.2)
                    if markV > des + 0.05 then hold(true)
                    elseif markV < des - 0.05 then hold(false) end
                    st.info = string.format("err %.3f", math.abs(fishY - barY))
                end)
                while alive() and st.on and hook() and tick() - t0 < st.miniTimeout do
                    task.wait(0.1)
                end
                pcall(function() mconn:Disconnect() end)
                hold(false)
                if not hook() then st.catches = st.catches + 1 st.info = "caught!" end
                return
            end
            st.phase = "wait-bite" st.info = "waiting for bite..."
            if tick() - (st.castT or tick()) > st.biteTimeout then
                st.info = "bite timeout, recast"
                local cx, cy = screenCenter()
                clickAt(cx, cy)
            end
        end)
        if not ok then st.info = "err: " .. tostring(err):sub(1, 60) end
    end
end)


