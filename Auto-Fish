local function shopCycle(needBuy, needSell)
    st.shopping = true hold(false)
    st.phase = "shop" st.info = "tp shop"
    print("[shop] cycle buy=" .. tostring(needBuy) .. " sell=" .. tostring(needSell))
    if needBuy then
        st.info = "tp bait"
        tweenTp(BAIT_SPOT)
        task.wait(0.5)
        st.info = "buying bait"
        local ok, msg = buyBait(BAIT_MAX)
        if type(ok) == "number" then st.baitHave = ok end
        print("[shop] buy: " .. tostring(ok) .. " " .. tostring(msg))
    end
    if needSell then
        st.info = "tp sell"
        tweenTp(SELL_SPOT)
        task.wait(0.5)
        st.info = "selling"
        pressKey(VK_T, 0.8)
        task.wait(1.0)
        npcGoExpect("fish")
        task.wait(1.2)
        local n = clickSellAlls()
        print("[shop] sold buttons=" .. n)
        finishDots()
        closeDialog()
        closeFishGui()
        st.soldAt = st.catches
    end
    st.info = "tp back"
    tweenTp(FISH_SPOT)
    task.wait(0.3)
    print("[shop] rod equipped=" .. tostring(equipRod()))
    st.shopping = false
end




local function miniHold()
    local bill = gui("FishingUIBill")
    if not bill then return nil end
    local okF, fr = pcall(function() return bill.Frame end)
    if not okF or not fr then return nil end
    local ok, p, g, fpos, fsize = pcall(function()
        return fr:FindFirstChild("Player"), fr:FindFirstChild("Goal"),
               fr.AbsolutePosition, fr.AbsoluteSize
    end)
    if ok and p and g and fpos and fsize and fsize.Y > 0 then
        local ok2, pp, ps, gp, gs = pcall(function()
            return p.AbsolutePosition, p.AbsoluteSize, g.AbsolutePosition, g.AbsoluteSize
        end)
        if ok2 then
            local barY = (pp.Y + ps.Y / 2 - fpos.Y) / fsize.Y
            local fishY = (gp.Y + gs.Y / 2 - fpos.Y) / fsize.Y
            if fishY < barY - 0.02 then return true end
            if fishY > barY + 0.02 then return false end
            return nil
        end
    end
    local it = fr:FindFirstChild("InfoText")
    if it then
        local ok3, t = pcall(function() return it.Text end)
        if ok3 then
            if t == "HOLD CLICK" then return true end
            if t == "RELEASE CLICK" then return false end
        end
    end
    return nil
end


