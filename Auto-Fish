local function fieldGuess(q)
    local bx, by = btnCenter(q.buy)
    if not bx then return nil end
    if q.cancel then
        local cx, cy = btnCenter(q.cancel)
        if cx then return (bx + cx) / 2, (by + cy) / 2 end
    end
    return bx + 117, by
end
