local function btnCenter(b)
    local ok, p, s = pcall(function() return b.AbsolutePosition, b.AbsoluteSize, b.Visible end)
    if not ok or not p or not s then return nil end
    return p.X + s.X / 2, p.Y + s.Y / 2
end

local mouseHeld = false
local function hold(down)
    if down and not mouseHeld then mouse1press() mouseHeld = true
    elseif not down and mouseHeld then mouse1release() mouseHeld = false end
end

local function viewport()
    local vs = Camera and Camera.ViewportSize
    if vs then return vs.X, vs.Y end
    return 1600, 900
end

local function clickable(b)
    local ok, p, s = pcall(function() return b.AbsolutePosition, b.AbsoluteSize end)
    if not ok or not p or not s then return false end
    if s.X < 10 or s.Y < 5 then return false end
    local vx, vy = viewport()
    if p.X < -50 or p.Y < -50 or p.X > vx + 50 or p.Y > vy + 50 then return false end
    return true
end
local function clickAt(x, y)
    hold(false)
    mousemoveabs(x, y)
    task.wait(0.08)
    mousemoverel(2, 0) task.wait(0.03)
    mousemoverel(-2, 0) task.wait(0.05)
    mouse1click()
    task.wait(0.15)
end

