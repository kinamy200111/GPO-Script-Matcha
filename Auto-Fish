local function tweenTp(pos, steps)
    steps = steps or 12
    local ch = lp and lp.Character
    local root = ch and ch:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local ok, start = pcall(function() return root.CFrame end)
    if not ok or not start then return false end
    local rot = start - start.Position
    for i = 1, steps do
        if not alive() then return false end
        pcall(function()
            root.CFrame = start:Lerp(CFrame.new(pos.X, pos.Y, pos.Z) * rot, i / steps)
        end)
        task.wait(0.06)
    end
    return true
end

